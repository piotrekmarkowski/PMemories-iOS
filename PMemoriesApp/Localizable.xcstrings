    "Unsaved changes (e.g. a linked video) will be lost.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُفقد التغييرات غير المحفوظة (مثل فيديو مرتبط)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Neuložené změny (např. propojené video) budou ztraceny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke-gemte ændringer (f.eks. en tilknyttet video) vil gå tabt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht gespeicherte Änderungen (z. B. ein verknüpftes Video) gehen verloren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι μη αποθηκευμένες αλλαγές (π.χ. ένα συνδεδεμένο βίντεο) θα χαθούν."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios no guardados (p. ej., un vídeo vinculado) se perderán."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallentamattomat muutokset (esim. linkitetty video) menetetään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications non enregistrées (par ex. une vidéo associée) seront perdues."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שינויים שלא נשמרו (למשל סרטון מקושר) יאבדו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिना सहेजे बदलाव (जैसे लिंक किया गया वीडियो) खो जाएंगे।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A nem mentett módosítások (pl. egy kapcsolt videó) elvesznek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan yang belum disimpan (mis. video yang tertaut) akan hilang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche non salvate (ad es. un video collegato) andranno perse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されていない変更（リンクされた動画など）は失われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장하지 않은 변경 사항(예: 연결된 동영상)은 사라집니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulagrede endringer (f.eks. en koblet video) vil gå tapt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet-opgeslagen wijzigingen (bijv. een gekoppelde video) gaan verloren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niezapisane zmiany (np. połączenie z filmem) zostaną utracone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterações não salvas (por exemplo, um vídeo vinculado) serão perdidas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações não guardadas (por exemplo, um vídeo associado) serão perdidas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modificările nesalvate (de ex. un videoclip legat) se vor pierde."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Osparade ändringar (t.ex. en länkad video) går förlorade."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปลี่ยนแปลงที่ยังไม่บันทึก (เช่น วิดีโอที่เชื่อมโยง) จะสูญหาย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilmemiş değişiklikler (örn. bağlı bir video) kaybolacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Незбережені зміни (наприклад, прив'язане відео) будуть втрачені."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
