    "Add cities, dates, flights and hotel notes before you go — after the trip, convert it straight into a Memory.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف المدن والتواريخ والرحلات وملاحظات الفنادق قبل السفر — بعد الرحلة، حوّلها مباشرة إلى ذكرى."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte města, data, lety a poznámky k hotelům před odjezdem — po cestě to rovnou převeďte na vzpomínku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj byer, datoer, fly og hotelnotater, før du tager af sted — efter turen kan du konvertere det direkte til et minde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Städte, Daten, Flüge und Hotelnotizen hinzu, bevor du losfährst — nach der Reise wandelst du sie direkt in eine Erinnerung um."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε πόλεις, ημερομηνίες, πτήσεις και σημειώσεις ξενοδοχείων πριν φύγετε — μετά το ταξίδι, μετατρέψτε το κατευθείαν σε ανάμνηση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade ciudades, fechas, vuelos y notas sobre hoteles antes de salir — después del viaje, conviértelo directamente en un recuerdo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää kaupungit, päivämäärät, lennot ja hotellimuistiinpanot ennen lähtöä — matkan jälkeen muunna se suoraan muistoksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez villes, dates, vols et notes d'hôtel avant de partir — après le voyage, convertissez-le directement en souvenir."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסף ערים, תאריכים, טיסות והערות מלון לפני היציאה — אחרי הטיול, הפוך זאת ישירות לזיכרון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जाने से पहले शहर, तारीखें, फ़्लाइट और होटल नोट्स जोड़ें — यात्रा के बाद इसे सीधे मेमोरी में बदल दें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Add hozzá a városokat, dátumokat, járatokat és szállodai jegyzeteket indulás előtt — utazás után rögtön alakítsd emlékké."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan kota, tanggal, penerbangan, dan catatan hotel sebelum berangkat — setelah perjalanan, ubah langsung menjadi kenangan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi città, date, voli e note sugli hotel prima di partire — dopo il viaggio, trasformalo direttamente in un ricordo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出発前に都市、日程、フライト、ホテルのメモを追加しましょう — 旅行後はそのままメモリーに変換できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출발 전에 도시, 날짜, 항공편, 호텔 메모를 추가하세요 — 여행 후 바로 메모리로 변환할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til byer, datoer, fly og hotellnotater før du drar — etter turen kan du gjøre det om til et minne med en gang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg steden, data, vluchten en hotelnotities toe voordat je vertrekt — na de reis zet je het direct om in een herinnering."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj miasta, daty, loty i notatki o hotelach zanim wyjedziesz — po powrocie od razu zamień to w Memory."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione cidades, datas, voos e notas de hotel antes de viajar — depois da viagem, converta tudo direto em uma lembrança."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona cidades, datas, voos e notas de hotel antes de partires — depois da viagem, converte tudo diretamente numa memória."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă orașe, date, zboruri și notițe despre hoteluri înainte de plecare — după călătorie, transformă-l direct într-o amintire."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till städer, datum, flyg och hotellanteckningar innan du åker — efter resan omvandlar du det direkt till ett minne."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มเมือง วันที่ เที่ยวบิน และบันทึกโรงแรมก่อนออกเดินทาง — หลังทริปเปลี่ยนเป็นความทรงจำได้ทันที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yola çıkmadan önce şehirleri, tarihleri, uçuşları ve otel notlarını ekle — seyahatten sonra bunu doğrudan bir anıya dönüştür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте міста, дати, рейси та нотатки про готелі перед виїздом — після подорожі одразу перетворіть це на спогад."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm thành phố, ngày tháng, chuyến bay và ghi chú khách sạn trước khi đi — sau chuyến đi, chuyển thẳng thành kỷ niệm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出发前添加城市、日期、航班和酒店备注——旅行结束后可直接转换为回忆。"
          }
        }
      }
    },
