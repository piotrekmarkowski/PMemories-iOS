    "Higher quality means a larger file and a longer export time.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجودة الأعلى تعني ملفًا أكبر ووقت تصدير أطول."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyšší kvalita znamená větší soubor a delší dobu exportu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Højere kvalitet betyder en større fil og længere eksporttid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höhere Qualität bedeutet eine größere Datei und eine längere Exportzeit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Υψηλότερη ποιότητα σημαίνει μεγαλύτερο αρχείο και μεγαλύτερο χρόνο εξαγωγής."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mayor calidad significa un archivo más grande y un tiempo de exportación más largo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Korkeampi laatu tarkoittaa suurempaa tiedostoa ja pidempää vientiaikaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une qualité plus élevée signifie un fichier plus volumineux et un temps d'exportation plus long."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "איכות גבוהה יותר משמעה קובץ גדול יותר וזמן ייצוא ארוך יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उच्च गुणवत्ता का मतलब है बड़ी फ़ाइल और लंबा निर्यात समय।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A magasabb minőség nagyobb fájlt és hosszabb exportidőt jelent."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kualitas lebih tinggi berarti file lebih besar dan waktu ekspor lebih lama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una qualità superiore significa un file più grande e un tempo di esportazione più lungo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画質を上げるとファイルサイズが大きくなり、書き出し時間も長くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화질이 높을수록 파일 크기가 커지고 내보내기 시간도 길어집니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Høyere kvalitet betyr en større fil og lengre eksporttid."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hogere kwaliteit betekent een groter bestand en een langere exporttijd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyższa jakość = większy plik i dłuższy czas eksportu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualidade maior significa um arquivo maior e um tempo de exportação mais longo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma qualidade superior significa um ficheiro maior e um tempo de exportação mais longo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Calitate mai mare înseamnă un fișier mai mare și un timp de export mai lung."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Högre kvalitet innebär en större fil och längre exporttid."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณภาพที่สูงขึ้นหมายถึงไฟล์ที่ใหญ่ขึ้นและใช้เวลาส่งออกนานขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha yüksek kalite, daha büyük dosya ve daha uzun aktarma süresi anlamına gelir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вища якість означає більший файл і довший час експорту."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chất lượng cao hơn nghĩa là tệp lớn hơn và thời gian xuất lâu hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画质越高，文件越大，导出时间也越长。"
          }
        }
      }
    },
