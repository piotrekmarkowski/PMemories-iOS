    "Edit transitions, captions and music in Studio, then find every finished movie in your Library.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدّل الانتقالات والتعليقات والموسيقى في الاستوديو، ثم اعثر على كل فيلم منتهٍ في مكتبتك."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upravujte přechody, titulky a hudbu ve Studiu a poté najděte každý hotový film ve své knihovně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rediger overgange, tekster og musik i Studiet, og find derefter hver færdig film i dit bibliotek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bearbeite Übergänge, Untertitel und Musik im Studio und finde jeden fertigen Film anschließend in deiner Bibliothek."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επεξεργαστείτε μεταβάσεις, λεζάντες και μουσική στο Στούντιο, και βρείτε κάθε ολοκληρωμένη ταινία στη Βιβλιοθήκη σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Edita transiciones, subtítulos y música en el Estudio, y luego encuentra cada película terminada en tu biblioteca."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muokkaa siirtymiä, tekstityksiä ja musiikkia Studiossa ja löydä jokainen valmis elokuva kirjastostasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiez les transitions, sous-titres et musiques dans le Studio, puis retrouvez chaque film terminé dans votre bibliothèque."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ערכו מעברים, כתוביות ומוזיקה באולפן, ואז מצאו כל סרט מוגמר בספרייה שלכם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्टूडियो में ट्रांज़िशन, कैप्शन और संगीत संपादित करें, फिर अपनी लाइब्रेरी में हर पूरी हो चुकी मूवी खोजें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szerkeszd az átmeneteket, feliratokat és zenét a Stúdióban, majd találd meg minden elkészült filmedet a Könyvtárban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunting transisi, teks, dan musik di Studio, lalu temukan setiap film yang selesai di Pustakamu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica transizioni, didascalie e musica nello Studio, poi trova ogni film completato nella tua libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スタジオでトランジション、キャプション、音楽を編集し、完成したムービーはすべてライブラリで見つけられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스튜디오에서 전환 효과, 자막, 음악을 편집하고, 완성된 영화는 보관함에서 모두 확인하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rediger overganger, tekster og musikk i Studio, og finn deretter hver ferdige film i biblioteket ditt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewerk overgangen, bijschriften en muziek in Studio, en vind daarna elke voltooide film in je bibliotheek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Edytuj przejścia, napisy i muzykę w Studio, a potem znajdź każdy gotowy film w swojej Bibliotece."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Edite transições, legendas e música no Estúdio e depois encontre cada filme pronto na sua biblioteca."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Edite transições, legendas e música no Estúdio e depois encontre cada filme concluído na sua biblioteca."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Editează tranziții, subtitrări și muzică în Studio, apoi găsește fiecare film finalizat în Biblioteca ta."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Redigera övergångar, texter och musik i Studion, och hitta sedan varje färdig film i ditt bibliotek."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แก้ไขการเปลี่ยนฉาก คำบรรยาย และเพลงในสตูดิโอ จากนั้นค้นหาภาพยนตร์ที่เสร็จสมบูรณ์ทุกเรื่องในคลังของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stüdyoda geçişleri, altyazıları ve müziği düzenle, ardından tamamlanan tüm filmleri Kitaplığında bul."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Редагуйте переходи, підписи та музику в Студії, а потім знаходьте кожен готовий фільм у своїй Бібліотеці."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉnh sửa hiệu ứng chuyển cảnh, chú thích và nhạc trong Studio, sau đó tìm mọi bộ phim hoàn chỉnh trong Thư viện của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在工作室中编辑转场、字幕和音乐，然后在资料库中找到每一部完成的电影。"
          }
        }
      }
    },
