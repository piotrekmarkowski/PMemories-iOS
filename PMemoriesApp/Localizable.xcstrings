    "Top level — no ceiling, your score keeps growing": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المستوى الأعلى — بلا حد أقصى، نقاطك تستمر في النمو"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejvyšší úroveň — bez stropu, vaše skóre stále roste"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Højeste niveau — intet loft, dine point fortsætter med at vokse"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höchstes Level — keine Obergrenze, deine Punktzahl wächst weiter"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανώτατο επίπεδο — χωρίς όριο, η βαθμολογία σας συνεχίζει να αυξάνεται"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nivel máximo — sin límite, tu puntuación sigue creciendo"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ylin taso — ei kattoa, pisteesi jatkavat kasvamista"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Niveau maximum — sans plafond, votre score continue de croître"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רמה עליונה — ללא תקרה, הניקוד שלך ממשיך לגדול"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शीर्ष स्तर — कोई सीमा नहीं, आपका स्कोर बढ़ता रहता है"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Legfelső szint — nincs felső határ, a pontszámod folyamatosan nő"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Level teratas — tanpa batas, skor Anda terus bertambah"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Livello massimo — senza limite, il tuo punteggio continua a crescere"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最高レベル — 上限なし、スコアは伸び続けます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최고 레벨 — 상한 없음, 점수가 계속 늘어납니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Høyeste nivå — ingen øvre grense, poengsummen din fortsetter å vokse"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoogste niveau — geen plafond, je score blijft groeien"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najwyższy poziom — bez sufitu, wynik dalej rośnie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nível máximo — sem teto, sua pontuação continua crescendo"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nível máximo — sem limite, a sua pontuação continua a crescer"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nivel maxim — fără limită, scorul tău continuă să crească"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Högsta nivå — inget tak, dina poäng fortsätter att växa"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระดับสูงสุด — ไม่มีเพดาน คะแนนของคุณจะเพิ่มขึ้นเรื่อย ๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En üst seviye — üst sınır yok, puanınız artmaya devam ediyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Найвищий рівень — без стелі, ваш бал продовжує зростати"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cấp cao nhất — không giới hạn, điểm của bạn tiếp tục tăng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "顶级 — 没有上限，你的分数会持续增长"
          }
        }
      }
    },
