        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δημιουργήστε πρώτα μια ανάμνηση με «Δημιουργία Ανάμνησης» — το Studio θα την ανοίξει για περαιτέρω επεξεργασία"
          }
        },
        "es": {
          "stringUnit": {
