          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A exportação pode demorar algum tempo (aprox. ~%@) — estamos a trabalhar para a tornar mais rápida 🙂"
          }
        },
        "ro": {
          "stringUnit": {
