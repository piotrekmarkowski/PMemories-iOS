    "Sign in to see how your Explorer Score compares with other testers.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول لترى كيف تقارن نتيجتك Explorer Score مع المختبرين الآخرين."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přihlaste se a zjistěte, jak si vaše skóre Explorer Score vede ve srovnání s ostatními testery."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ind for at se, hvordan din Explorer Score sammenlignes med andre testere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich an, um zu sehen, wie dein Explorer Score im Vergleich zu anderen Testern abschneidet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδεθείτε για να δείτε πώς συγκρίνεται το Explorer Score σας με άλλους δοκιμαστές."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión para ver cómo se compara tu puntuación Explorer Score con la de otros testers."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaudu sisään nähdäksesi, miten Explorer Score -pisteesi vertautuu muihin testaajiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous pour voir comment votre score Explorer se compare à celui des autres testeurs."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היכנס כדי לראות כיצד ה-Explorer Score שלך משתווה לבודקים אחרים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह देखने के लिए साइन इन करें कि आपका Explorer Score अन्य टेस्टर्स की तुलना में कैसा है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelentkezz be, hogy megnézd, hogyan viszonyul az Explorer Score-od a többi teszterhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk untuk melihat perbandingan Explorer Score Anda dengan penguji lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi per vedere come si confronta il tuo Explorer Score con quello degli altri tester."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインして、あなたのExplorer Scoreが他のテスターと比べてどうかを確認しよう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인하여 다른 테스터와 Explorer Score를 비교해 보세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logg inn for å se hvordan Explorer Score din er sammenlignet med andre testere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log in om te zien hoe jouw Explorer Score zich verhoudt tot andere testers."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się, aby zobaczyć, jak Twój wynik Explorer Score wypada na tle innych testerów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre para ver como sua pontuação Explorer Score se compara à de outros testadores."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sessão para veres como a tua pontuação Explorer Score se compara à de outros testadores."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentifică-te pentru a vedea cum se compară scorul tău Explorer cu al altor testeri."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logga in för att se hur din Explorer Score står sig mot andra testare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลงชื่อเข้าใช้เพื่อดูว่าคะแนน Explorer Score ของคุณเทียบกับผู้ทดสอบคนอื่นเป็นอย่างไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Explorer Score'unun diğer test kullanıcılarıyla nasıl karşılaştırıldığını görmek için giriş yap."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увійдіть, щоб побачити, як ваш Explorer Score порівнюється з іншими тестувальниками."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập để xem điểm Explorer Score của bạn so với những người thử nghiệm khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录以查看你的探索者分数与其他测试者的对比。"
          }
        }
      }
    },
    "Sign in with Apple failed. Please try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل تسجيل الدخول عبر Apple. يرجى المحاولة مرة أخرى."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přihlášení přes Apple se nezdařilo. Zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ind med Apple mislykkedes. Prøv igen."
          }
        },
        "de": {
