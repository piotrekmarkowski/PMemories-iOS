    "Track your trips on an animated map and turn your route into a cinematic video.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتبّع رحلاتك على خريطة متحركة وحوّل مسارك إلى فيديو سينمائي."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledujte své cesty na animované mapě a proměňte svou trasu v kinematografické video."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Følg dine rejser på et animeret kort, og gør din rute til en filmisk video."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfolge deine Reisen auf einer animierten Karte und verwandle deine Route in ein filmisches Video."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παρακολουθήστε τα ταξίδια σας σε έναν κινούμενο χάρτη και μετατρέψτε τη διαδρομή σας σε κινηματογραφικό βίντεο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue tus viajes en un mapa animado y convierte tu ruta en un vídeo cinematográfico."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuraa matkojasi animoidulla kartalla ja muuta reittisi elokuvalliseksi videoksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez vos voyages sur une carte animée et transformez votre itinéraire en vidéo cinématographique."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עקבו אחר הטיולים שלכם על מפה מונפשת והפכו את המסלול לסרטון קולנועי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी यात्राओं को एनिमेटेड मानचित्र पर देखें और अपने रूट को एक सिनेमाई वीडियो में बदलें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kövesd nyomon utazásaidat egy animált térképen, és alakítsd útvonaladat filmszerű videóvá."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lacak perjalananmu di peta animasi dan ubah rutemu menjadi video sinematik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segui i tuoi viaggi su una mappa animata e trasforma il tuo percorso in un video cinematografico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アニメーションマップで旅の軌跡を確認し、ルートを映画のような動画に変換できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "애니메이션 지도에서 여행 경로를 추적하고, 이를 영화 같은 영상으로 만들어보세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Følg reisene dine på et animert kart, og gjør ruten din til en filmatisk video."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volg je reizen op een geanimeerde kaart en zet je route om in een filmische video."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Śledź swoje podróże na animowanej mapie i zamień trasę w kinowe wideo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acompanhe suas viagens em um mapa animado e transforme sua rota em um vídeo cinematográfico."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Acompanhe as suas viagens num mapa animado e transforme o seu trajeto num vídeo cinematográfico."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Urmărește-ți călătoriile pe o hartă animată și transformă traseul într-un videoclip cinematic."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Följ dina resor på en animerad karta och gör din rutt till en filmisk video."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตามการเดินทางของคุณบนแผนที่แบบเคลื่อนไหว และเปลี่ยนเส้นทางของคุณให้เป็นวิดีโอสไตล์ภาพยนตร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seyahatlerini animasyonlu bir haritada takip et ve rotanı sinematik bir videoya dönüştür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відстежуйте свої подорожі на анімованій карті та перетворюйте маршрут на кінематографічне відео."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo dõi các chuyến đi của bạn trên bản đồ động và biến lộ trình thành video điện ảnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在动态地图上追踪你的旅程，把路线变成一段电影感十足的视频。"
          }
        }
      }
    },
