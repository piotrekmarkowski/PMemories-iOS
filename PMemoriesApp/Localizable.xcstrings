        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Alakítsd fotóidat és videóidat néhány érintéssel zenés filmmé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubah foto dan videomu menjadi film berpadu musik hanya dengan beberapa ketukan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasforma le tue foto e i tuoi video in un film con musica in pochi tocchi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真や動画を数タップで音楽付きのムービーに変換できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진과 동영상을 몇 번의 탭으로 음악이 있는 영화로 만들어보세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjør bildene og videoene dine til en film med musikk på noen få trykk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak van je foto's en video's een film met muziek in een paar tikken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamień swoje zdjęcia i wideo w film z muzyką w kilku dotknięciach."
          }
        },
        "pt-BR": {
          "stringUnit": {
