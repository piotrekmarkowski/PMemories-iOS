    "Export was interrupted because PMemories left the foreground. Keep the app open while exporting to avoid this.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إيقاف التصدير لأن PMemories غادر المقدمة. أبقِ التطبيق مفتوحًا أثناء التصدير لتجنب ذلك."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Export byl přerušen, protože aplikace PMemories opustila popředí. Aby k tomu nedocházelo, nechte aplikaci během exportu otevřenou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksporten blev afbrudt, fordi PMemories forlod forgrunden. Hold appen åben under eksporten for at undgå dette."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Export wurde unterbrochen, weil PMemories in den Hintergrund gewechselt ist. Halte die App während des Exports geöffnet, um dies zu vermeiden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εξαγωγή διακόπηκε επειδή το PMemories εγκατέλειψε το προσκήνιο. Κρατήστε την εφαρμογή ανοιχτή κατά την εξαγωγή για να το αποφύγετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La exportación se interrumpió porque PMemories dejó de estar en primer plano. Mantén la app abierta durante la exportación para evitarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vienti keskeytyi, koska PMemories siirtyi taustalle. Pidä sovellus auki viennin aikana välttääksesi tämän."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'exportation a été interrompue car PMemories est passé en arrière-plan. Gardez l'application ouverte pendant l'exportation pour éviter cela."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הייצוא הופסק מכיוון ש-PMemories עזב את החזית. השאר את האפליקציה פתוחה בזמן הייצוא כדי למנוע זאת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PMemories फ़ोरग्राउंड से हट जाने के कारण एक्सपोर्ट रुक गया। इससे बचने के लिए एक्सपोर्ट करते समय ऐप को खुला रखें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az exportálás megszakadt, mert a PMemories a háttérbe került. Ennek elkerülése érdekében tartsd nyitva az appot exportálás közben."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekspor terganggu karena PMemories meninggalkan latar depan. Jaga aplikasi tetap terbuka saat mengekspor untuk menghindari ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'esportazione è stata interrotta perché PMemories è passata in background. Tieni l'app aperta durante l'esportazione per evitarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PMemoriesがフォアグラウンドから外れたため、エクスポートが中断されました。これを避けるには、エクスポート中はアプリを開いたままにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PMemories가 백그라운드로 전환되어 내보내기가 중단되었습니다. 이를 방지하려면 내보내는 동안 앱을 열어두세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksporten ble avbrutt fordi PMemories forlot forgrunnen. Hold appen åpen under eksporten for å unngå dette."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het exporteren is onderbroken omdat PMemories de voorgrond verliet. Houd de app open tijdens het exporteren om dit te voorkomen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksport został przerwany, ponieważ PMemories zeszło z pierwszego planu. Trzymaj aplikację otwartą podczas eksportowania, aby tego uniknąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A exportação foi interrompida porque o PMemories saiu do primeiro plano. Mantenha o app aberto durante a exportação para evitar isso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A exportação foi interrompida porque o PMemories saiu do primeiro plano. Mantém a app aberta durante a exportação para evitar isto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportul a fost întrerupt deoarece PMemories a părăsit prim-planul. Ține aplicația deschisă în timpul exportului pentru a evita acest lucru."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporten avbröts eftersom PMemories lämnade förgrunden. Håll appen öppen under exporten för att undvika detta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การส่งออกถูกขัดจังหวะเนื่องจาก PMemories ออกจากด้านหน้า เปิดแอปค้างไว้ระหว่างการส่งออกเพื่อหลีกเลี่ยงปัญหานี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PMemories ön plandan ayrıldığı için dışa aktarma kesintiye uğradı. Bunu önlemek için dışa aktarma sırasında uygulamayı açık tut."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Експорт було перервано, оскільки PMemories залишив передній план. Тримайте застосунок відкритим під час експорту, щоб цього уникнути."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quá trình xuất bị gián đoạn vì PMemories rời khỏi nền trước. Hãy giữ ứng dụng mở trong khi xuất để tránh điều này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于 PMemories 离开前台，导出已中断。导出期间请保持应用处于打开状态以避免此问题。"
          }
        }
      }
    },
