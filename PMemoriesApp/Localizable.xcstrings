    "Reopen PMemories afterwards to see it in the new language.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد فتح PMemories بعد ذلك لرؤيته باللغة الجديدة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poté PMemories znovu otevřete, abyste viděli nový jazyk."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn PMemories igen bagefter for at se det på det nye sprog."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne PMemories danach erneut, um die neue Sprache zu sehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε ξανά το PMemories για να το δείτε στη νέα γλώσσα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a abrir PMemories para verla en el nuevo idioma."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa PMemories uudelleen nähdäksesi uuden kielen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rouvrez PMemories pour la voir dans la nouvelle langue."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתח מחדש את PMemories כדי לראות את השפה החדשה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नई भाषा देखने के लिए PMemories फिर से खोलें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezután nyisd meg újra a PMemories-t az új nyelv megtekintéséhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka kembali PMemories untuk melihatnya dalam bahasa baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riapri PMemories per vederla nella nuova lingua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい言語を反映するには、PMemoriesを開き直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 언어를 확인하려면 PMemories를 다시 여세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne PMemories på nytt etterpå for å se det nye språket."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open PMemories daarna opnieuw om de nieuwe taal te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz PMemories ponownie, żeby zobaczyć nowy język."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reabra o PMemories depois para vê-lo no novo idioma."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Volte a abrir o PMemories para o ver no novo idioma."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Redeschide PMemories apoi pentru a o vedea în noua limbă."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna PMemories igen efteråt för att se det nya språket."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด PMemories อีกครั้งเพื่อดูภาษาใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni dili görmek için PMemories'i tekrar açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте PMemories знову, щоб побачити нову мову."
          }
        },
        "vi": {
