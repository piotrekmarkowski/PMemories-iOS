    "Choose a subtle background skin for your tabs. \"Seasonal\" automatically changes with the time of year.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مظهر خلفية أنيق لعلاماتك التبويب. يتغير \"الموسمي\" تلقائيًا حسب وقت السنة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte si jemný motiv pozadí pro vaše karty. „Sezónní“ se automaticky mění podle ročního období."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg et diskret baggrundsskin til dine faner. \"Sæsonbestemt\" ændres automatisk med årstiden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen dezenten Hintergrund für deine Tabs. „Saisonal\" ändert sich automatisch je nach Jahreszeit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε ένα διακριτικό φόντο για τις καρτέλες σας. Το \"Εποχιακό\" αλλάζει αυτόματα ανάλογα με την εποχή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una skin de fondo sutil para tus pestañas. \"Estacional\" cambia automáticamente según la época del año."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse hillitty taustateema välilehdillesi. ”Kausiluonteinen” muuttuu automaattisesti vuodenajan mukaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un habillage de fond discret pour vos onglets. « Saisonnier » change automatiquement selon la période de l'année."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר ערכת רקע עדינה לכרטיסיות שלך. \"עונתי\" משתנה אוטומטית לפי תקופת השנה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने टैब के लिए एक सूक्ष्म बैकग्राउंड स्किन चुनें। \"मौसमी\" साल के समय के साथ अपने आप बदलता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassz visszafogott háttértémát a füleidhez. Az \"Évszakos\" automatikusan változik az évszaknak megfelelően."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih skin latar belakang yang halus untuk tab Anda. \"Musiman\" berubah otomatis sesuai waktu dalam setahun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli uno sfondo discreto per le tue schede. \"Stagionale\" cambia automaticamente in base al periodo dell'anno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブの控えめな背景スキンを選択しましょう。「季節」は季節に応じて自動的に変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭에 은은한 배경 스킨을 선택하세요. \"계절별\"은 계절에 따라 자동으로 바뀝니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg et diskré bakgrunnsskin for fanene dine. «Sesongbasert» endres automatisk med årstiden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een subtiele achtergrondskin voor je tabbladen. \"Seizoensgebonden\" verandert automatisch met het jaargetijde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz subtelną skórkę tła dla zakładek. „Sezonowa” zmienia się automatycznie wraz z porą roku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um tema de fundo sutil para suas abas. \"Sazonal\" muda automaticamente com a época do ano."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe um tema de fundo subtil para os teus separadores. \"Sazonal\" muda automaticamente consoante a época do ano."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege un skin de fundal discret pentru filele tale. „Sezonier\" se schimbă automat în funcție de anotimp."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj en diskret bakgrundsskin för dina flikar. \"Säsongsbetonad\" ändras automatiskt med årstiden."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกสกินพื้นหลังที่ดูกลมกลืนสำหรับแท็บของคุณ \"ตามฤดูกาล\" จะเปลี่ยนอัตโนมัติตามช่วงเวลาของปี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekmelerin için sade bir arka plan teması seç. \"Mevsimsel\" yıl boyunca otomatik olarak değişir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть непомітну тему фону для вкладок. \"Сезонна\" автоматично змінюється залежно від пори року."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn hình nền tinh tế cho các tab của bạn. \"Theo mùa\" sẽ tự động thay đổi theo thời điểm trong năm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为你的标签页选择一个低调的背景皮肤。\"季节性\"会随季节自动变化。"
          }
        }
      }
    },
    "Choose which transitions PMemories can use — it will spread the ones you pick automatically between your clips.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر الانتقالات التي يمكن لـ PMemories استخدامها — سيقوم بتوزيع ما تختاره تلقائيًا بين مقاطعك."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte, které přechody může PMemories používat — vybrané automaticky rozmístí mezi vaše klipy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg hvilke overgange PMemories må bruge — den fordeler automatisk dem, du vælger, mellem dine klip."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle aus, welche Übergänge PMemories verwenden darf — die ausgewählten werden automatisch zwischen deinen Clips verteilt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επίλεξε ποιες μεταβάσεις μπορεί να χρησιμοποιεί το PMemories — θα κατανείμει αυτόματα αυτές που επιλέγεις ανάμεσα στα κλιπ σου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué transiciones puede usar PMemories — distribuirá automáticamente las que elijas entre tus clips."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse, mitä siirtymiä PMemories saa käyttää — se jakaa valitsemasi automaattisesti klippiesi väliin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les transitions que PMemories peut utiliser — celles que vous sélectionnez seront réparties automatiquement entre vos clips."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר אילו מעברים PMemories יכול להשתמש בהם — הוא יפזר אוטומטית את אלה שתבחר בין הקליפים שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि PMemories कौन से ट्रांज़िशन इस्तेमाल कर सकता है — यह आपके चुने हुए ट्रांज़िशन को आपके क्लिप्स के बीच अपने आप बाँट देगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válaszd ki, mely átmeneteket használhatja a PMemories — a kiválasztottakat automatikusan elosztja a klipjeid között."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih transisi mana yang boleh digunakan PMemories — transisi yang kamu pilih akan disebar otomatis di antara klip-klipmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli quali transizioni può usare PMemories — distribuirà automaticamente quelle selezionate tra le tue clip."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PMemoriesが使用できるトランジションを選択してください — 選んだものをクリップの間に自動的に配置します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PMemories가 사용할 수 있는 전환 효과를 선택하세요 — 선택한 효과를 클립 사이에 자동으로 배치합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg hvilke overganger PMemories kan bruke — den fordeler automatisk de du velger mellom klippene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies welke overgangen PMemories mag gebruiken — de gekozen overgangen worden automatisch verdeeld over je clips."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, których przejść może używać PMemories — appka sama rozmieści wybrane pomiędzy Twoimi klipami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha quais transições o PMemories pode usar — ele vai distribuir automaticamente as que você escolher entre seus clipes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe que transições o PMemories pode usar — vai distribuir automaticamente as que escolheres entre os teus clips."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege ce tranziții poate folosi PMemories — le va distribui automat pe cele alese între clipurile tale."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj vilka övergångar PMemories får använda — den fördelar automatiskt de du väljer mellan dina klipp."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกการเปลี่ยนฉากที่ PMemories ใช้ได้ — ระบบจะกระจายฉากที่คุณเลือกโดยอัตโนมัติระหว่างคลิปของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PMemories'in kullanabileceği geçişleri seç — seçtiklerini kliplerin arasına otomatik olarak dağıtacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть, які переходи може використовувати PMemories — обрані переходи автоматично розподілятимуться між вашими кліпами."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn những kiểu chuyển cảnh mà PMemories có thể dùng — ứng dụng sẽ tự động phân bổ những kiểu bạn chọn giữa các đoạn clip."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择 PMemories 可以使用的转场效果——系统会自动将你选中的转场分配到各个片段之间。"
          }
        }
      }
    },
