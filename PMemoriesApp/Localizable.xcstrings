    "Sign in with Apple so PMemories can greet you by name and let you join the tester Ranking.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول عبر Apple حتى يتمكن PMemories من الترحيب بك باسمك والانضمام إلى تصنيف المختبرين."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přihlaste se přes Apple, aby vás PMemories mohl oslovovat jménem a abyste se mohli zapojit do žebříčku testerů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ind med Apple, så PMemories kan hilse på dig ved navn og lade dig deltage i testernes rangliste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich mit Apple an, damit PMemories dich mit Namen begrüßen und du an der Tester-Rangliste teilnehmen kannst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδέσου με Apple ώστε το PMemories να σε χαιρετά με το όνομά σου και να συμμετέχεις στην κατάταξη δοκιμαστών."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión con Apple para que PMemories pueda saludarte por tu nombre y puedas unirte a la clasificación de probadores."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaudu Applella, jotta PMemories voi tervehtiä sinua nimellä ja voit liittyä testaajien tulostauluun."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous avec Apple pour que PMemories puisse vous saluer par votre nom et vous permettre de rejoindre le classement des testeurs."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היכנס עם Apple כדי ש-PMemories יוכל לברך אותך בשמך ולאפשר לך להצטרף לדירוג הבודקים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple से साइन इन करें ताकि PMemories आपका नाम लेकर स्वागत कर सके और आप टेस्टर रैंकिंग में शामिल हो सकें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelentkezz be Apple-lel, hogy a PMemories a neveden szólíthasson, és csatlakozhass a tesztelői ranglistához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk dengan Apple agar PMemories dapat menyapa Anda dengan nama dan Anda dapat bergabung dengan Peringkat penguji."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi con Apple in modo che PMemories possa salutarti per nome e tu possa unirti alla classifica dei tester."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleでサインインすると、PMemoriesが名前で挨拶し、テスターランキングに参加できるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple로 로그인하면 PMemories가 이름으로 인사하고 테스터 랭킹에 참여할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logg inn med Apple slik at PMemories kan hilse på deg med navn og du kan bli med i testernes rangering."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log in met Apple zodat PMemories je bij naam kan begroeten en je kunt meedoen aan de testersranglijst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się przez Apple, żeby PMemories mogło witać Cię po imieniu i żebyś mógł dołączyć do rankingu testerów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre com a Apple para que o PMemories possa cumprimentá-lo pelo nome e você possa participar do Ranking de testadores."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie sessão com a Apple para que o PMemories o possa cumprimentar pelo nome e possa juntar-se ao Ranking de testadores."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectează-te cu Apple pentru ca PMemories să te poată saluta pe nume și să te poți alătura clasamentului testerilor."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logga in med Apple så att PMemories kan hälsa dig vid namn och du kan gå med i testarnas topplista."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลงชื่อเข้าใช้ด้วย Apple เพื่อให้ PMemories ทักทายคุณด้วยชื่อและเข้าร่วมอันดับผู้ทดสอบได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PMemories'in seni adınla karşılayabilmesi ve test kullanıcıları sıralamasına katılabilmen için Apple ile giriş yap."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увійдіть через Apple, щоб PMemories вітав вас на ім'я та щоб ви могли приєднатися до рейтингу тестувальників."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập bằng Apple để PMemories có thể chào bạn bằng tên và bạn có thể tham gia Bảng xếp hạng người thử nghiệm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Apple 登录，PMemories 就能用你的名字问候你，并让你加入测试者排行榜。"
          }
        }
      }
    },
