            "value": "Deine Reisen ansehen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δείτε τα ταξίδια σας"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ver tus viajes"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Katso matkasi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voir vos voyages"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צפה בטיולים שלך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी यात्राएं देखें"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Utak megtekintése"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat perjalanan Anda"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedi i tuoi viaggi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行を見る"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여행 보기"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se reisene dine"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk je reizen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobacz swoje podróże"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ver suas viagens"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ver as suas viagens"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vezi călătoriile tale"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se dina resor"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูทริปของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gezilerinizi görün"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переглянути ваші подорожі"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem chuyến đi của bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看你的行程"
          }
        }
      }
    },
    "Select the country you live in or come from — it won't count toward the \\\"Countries\\\" badge, Explorer Score, or Travel Passport, since that's not exploration. The list shows countries the app already knows from your saved trips.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر الدولة التي تعيش فيها أو تنتمي إليها — لن تُحتسب ضمن شارة \"الدول\" أو نقاط المستكشف أو جواز سفر الرحلات، لأن ذلك ليس استكشافًا. تعرض القائمة الدول التي يعرفها التطبيق بالفعل من رحلاتك المحفوظة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte zemi, ve které žijete nebo ze které pocházíte — nebude se počítat do odznaku \"Země\", Skóre Průzkumníka ani Cestovního pasu, protože to není průzkum. Seznam zobrazuje země, které aplikace už zná z vašich uložených cest."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg det land, du bor i eller kommer fra — det tæller ikke med til badgen \"Lande\", Opdagerpoint eller Rejsepas, da det ikke er udforskning. Listen viser lande, appen allerede kender fra dine gemte rejser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle das Land, in dem du lebst oder aus dem du kommst — es zählt nicht für das Abzeichen „Länder\", die Entdecker-Punktzahl oder den Reisepass, da das keine Entdeckung ist. Die Liste zeigt Länder, die die App bereits aus deinen gespeicherten Reisen kennt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε τη χώρα όπου ζείτε ή από όπου προέρχεστε — δεν θα προσμετρηθεί στο παράσημο «Χώρες», στη Βαθμολογία Εξερευνητή ή στο Διαβατήριο Ταξιδιού, καθώς αυτό δεν είναι εξερεύνηση. Η λίστα εμφανίζει χώρες που η εφαρμογή ήδη γνωρίζει από τα αποθηκευμένα ταξίδια σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona el país en el que vives o del que provienes — no contará para la insignia \"Países\", la Puntuación de Explorador ni el Pasaporte de Viaje, ya que eso no es exploración. La lista muestra los países que la app ya conoce por tus viajes guardados."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse maa, jossa asut tai josta olet kotoisin — se ei lasketa \"Maat\"-merkkiin, Tutkimuspisteisiin tai Matkapassiin, koska se ei ole tutkimusmatkailua. Lista näyttää maat, jotka sovellus jo tuntee tallennetuista matkoistasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez le pays où vous vivez ou d'où vous venez — il ne comptera pas pour le badge « Pays », le Score d'Explorateur ou le Passeport de Voyage, car ce n'est pas de l'exploration. La liste affiche les pays déjà connus grâce à vos voyages enregistrés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר את המדינה שבה אתה גר או ממנה הגעת — היא לא תיספר לתג \"מדינות\", לניקוד החוקר או לדרכון הטיולים, מכיוון שזה לא חקר. הרשימה מציגה מדינות שהאפליקציה כבר מכירה מהטיולים השמורים שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह देश चुनें जहां आप रहते हैं या जहां से हैं — यह \"देश\" बैज, एक्सप्लोरर स्कोर या ट्रैवल पासपोर्ट में नहीं गिना जाएगा, क्योंकि यह अन्वेषण नहीं है। सूची में वे देश दिखाए जाते हैं जिन्हें ऐप आपकी सहेजी गई यात्राओं से पहले से जानता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válaszd ki azt az országot, ahol élsz vagy ahonnan származol — ez nem számít bele az \"Országok\" jelvénybe, a Felfedező Pontszámba vagy az Útlevélbe, mivel ez nem felfedezés. A lista azokat az országokat mutatja, amelyeket az app már ismer a mentett utaidból."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih negara tempat Anda tinggal atau berasal — ini tidak akan dihitung untuk lencana \"Negara\", Skor Penjelajah, atau Paspor Perjalanan, karena itu bukan eksplorasi. Daftar menampilkan negara yang sudah diketahui aplikasi dari perjalanan tersimpan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona il paese in cui vivi o da cui provieni — non conterà per il distintivo \"Paesi\", il Punteggio Esploratore o il Passaporto di Viaggio, poiché non è esplorazione. L'elenco mostra i paesi già noti dai tuoi viaggi salvati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "住んでいる国、または出身国を選択してください — 「国」バッジやエクスプローラースコア、トラベルパスポートには反映されません（それは探検ではないためです）。リストには、保存済みの旅行からアプリがすでに把握している国が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거주 중이거나 출신인 국가를 선택하세요 — \"국가\" 배지, 탐험가 점수, 여행 여권에는 반영되지 않습니다 (탐험이 아니기 때문입니다). 목록에는 저장된 여행을 통해 앱이 이미 알고 있는 국가가 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg landet du bor i eller kommer fra — det teller ikke mot merket \"Land\", Oppdagerpoeng eller Reisepass, siden det ikke er utforskning. Listen viser land appen allerede kjenner fra dine lagrede reiser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer het land waar je woont of vandaan komt — het telt niet mee voor de badge \"Landen\", de Ontdekkersscore of het Reispaspoort, want dat is geen ontdekking. De lijst toont landen die de app al kent uit je opgeslagen reizen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznacz kraj w którym mieszkasz albo z którego pochodzisz — nie liczy się do odznaki „Kraje”, Explorer Score ani Travel Passport, bo to nie eksploracja. Lista pokazuje kraje, które appka już zna z Twoich zapisanych podróży."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione o país onde você mora ou de onde vem — ele não contará para o emblema \"Países\", a Pontuação de Explorador ou o Passaporte de Viagem, já que isso não é exploração. A lista mostra os países que o app já conhece pelas suas viagens salvas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione o país onde vive ou de onde é natural — não contará para o emblema \"Países\", a Pontuação de Explorador ou o Passaporte de Viagem, pois isso não é exploração. A lista mostra os países que a aplicação já conhece das suas viagens guardadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Selectează țara în care locuiești sau de unde ești — nu va conta pentru insigna \"Țări\", Scorul Explorator sau Pașaportul de Călătorie, deoarece nu este explorare. Lista arată țările pe care aplicația le cunoaște deja din călătoriile tale salvate."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj landet du bor i eller kommer från — det räknas inte till märket \"Länder\", Upptäckarpoängen eller Resepasset, eftersom det inte är upptäckt. Listan visar länder appen redan känner till från dina sparade resor."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกประเทศที่คุณอาศัยอยู่หรือมาจาก — จะไม่นับรวมในตรา \"ประเทศ\" คะแนนนักสำรวจ หรือพาสปอร์ตการเดินทาง เนื่องจากนั่นไม่ใช่การสำรวจ รายการแสดงประเทศที่แอปรู้จักแล้วจากทริปที่บันทึกไว้ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaşadığınız veya geldiğiniz ülkeyi seçin — bu, keşif sayılmadığı için \"Ülkeler\" rozetine, Kaşif Puanına veya Seyahat Pasaportuna sayılmaz. Liste, uygulamanın kayıtlı gezilerinizden zaten bildiği ülkeleri gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть країну, де ви живете або звідки ви родом — вона не враховуватиметься до значка \"Країни\", Балів Дослідника чи Паспорта подорожей, оскільки це не дослідження. У списку показані країни, які застосунок уже знає з ваших збережених подорожей."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn quốc gia bạn đang sống hoặc xuất thân — nó sẽ không tính vào huy hiệu \"Quốc gia\", Điểm Nhà Thám Hiểm hay Hộ chiếu Du lịch, vì đó không phải là khám phá. Danh sách hiển thị các quốc gia mà ứng dụng đã biết từ các chuyến đi đã lưu của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择你居住或来自的国家——它不会计入\"国家\"徽章、探险家分数或旅行护照，因为那不算探索。列表显示的是应用已从你保存的行程中获知的国家。"
          }
        }
      }
    },
    "Sends these stops to Travel Map to build your route, then removes this plan — your trip lives on there.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل هذه المحطات إلى خريطة السفر لبناء مسارك، ثم يزيل هذه الخطة — رحلتك تستمر هناك."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odešle tyto zastávky do Mapy cest a sestaví vaši trasu, poté tento plán odstraní — vaše cesta pokračuje tam."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sender disse stop til Rejsekortet for at bygge din rute og fjerner derefter denne plan — din rejse lever videre der."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet diese Stopps an die Reisekarte, um deine Route zu erstellen, und entfernt danach diesen Plan — deine Reise lebt dort weiter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στέλνει αυτές τις στάσεις στον Χάρτη Ταξιδιού για να δημιουργήσει τη διαδρομή σας και μετά αφαιρεί αυτό το σχέδιο — το ταξίδι σας συνεχίζεται εκεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía estas paradas al Mapa de Viajes para construir tu ruta y luego elimina este plan — tu viaje continúa allí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähettää nämä pysähdykset Matkakartalle reittisi rakentamiseksi ja poistaa sitten tämän suunnitelman — matkasi jatkuu siellä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie ces étapes à la carte de voyage pour construire votre itinéraire, puis supprime ce plan — votre voyage continue là-bas."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שולח את העצירות האלה למפת הטיולים כדי לבנות את המסלול שלך, ולאחר מכן מוחק את התוכנית הזו — הטיול שלך ממשיך שם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह पड़ावों को Travel Map पर भेजता है ताकि आपका मार्ग बन सके, फिर इस योजना को हटा देता है — आपकी यात्रा वहाँ जारी रहती है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elküldi ezeket a megállókat az Utazási térképre az útvonal felépítéséhez, majd törli ezt a tervet — az utazásod ott folytatódik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengirim perhentian ini ke Peta Perjalanan untuk membangun rute Anda, lalu menghapus rencana ini — perjalanan Anda berlanjut di sana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia queste tappe alla Mappa di Viaggio per costruire il tuo percorso, poi rimuove questo piano — il tuo viaggio continua lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの立ち寄り先をTravel Mapに送ってルートを作成し、その後この計画を削除します — 旅はそこで続きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 정류지들을 Travel Map으로 보내 경로를 만들고, 이 계획은 삭제됩니다 — 여행은 그곳에서 계속됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sender disse stoppene til Reisekartet for å bygge ruten din, og fjerner deretter denne planen — reisen din lever videre der."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuurt deze stops naar Travel Map om je route te bouwen en verwijdert daarna dit plan — je reis leeft daar verder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysyła te przystanki do Mapy Podróży, żeby zbudować trasę, a potem usuwa ten plan — Twoja podróż żyje dalej tam."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia essas paradas para o Mapa de Viagens para construir sua rota e depois remove este plano — sua viagem continua por lá."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia estas paragens para o Mapa de Viagens para construir a tua rota e depois remove este plano — a tua viagem continua por lá."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trimite aceste opriri către Harta călătoriilor pentru a construi ruta ta, apoi elimină acest plan — călătoria ta continuă acolo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skickar dessa stopp till Reskartan för att bygga din rutt och tar sedan bort denna plan — din resa lever vidare där."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งจุดแวะเหล่านี้ไปยัง Travel Map เพื่อสร้างเส้นทาง จากนั้นลบแผนนี้ออก — การเดินทางของคุณจะดำเนินต่อที่นั่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu durakları rotanı oluşturmak için Seyahat Haritası'na gönderir, ardından bu planı kaldırır — seyahatin orada devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надсилає ці зупинки на Карту подорожей для побудови маршруту, а потім видаляє цей план — ваша подорож живе далі там."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi các điểm dừng này đến Travel Map để xây dựng lộ trình, sau đó xóa kế hoạch này — chuyến đi của bạn tiếp tục ở đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将这些站点发送到旅行地图以构建路线，然后删除此计划——你的旅程会在那里继续。"
          }
        }
      }
    },
    "Set": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعيين"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavit"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Angiv"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Festlegen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ορισμός"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicar"
          }
