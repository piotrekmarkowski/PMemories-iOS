          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muuta valokuvasi ja videosi musiikilla höystetyksi elokuvaksi muutamalla napautuksella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transformez vos photos et vidéos en film avec musique en quelques tapotements."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפכו את התמונות והסרטונים שלכם לסרט עם מוזיקה בכמה הקשות בלבד."
