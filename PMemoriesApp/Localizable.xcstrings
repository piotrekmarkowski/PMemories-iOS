    "Defaults to your phone's language. Changing this closes the app — reopen it to see the new language.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم افتراضيًا لغة هاتفك. هذا التغيير يغلق التطبيق — أعد فتحه لرؤية اللغة الجديدة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve výchozím nastavení používá jazyk telefonu. Tato změna aplikaci zavře — znovu ji otevřete, abyste viděli nový jazyk."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruger som standard din telefons sprog. Denne ændring lukker appen — åbn den igen for at se det nye sprog."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig die Sprache deines Telefons. Diese Änderung schließt die App — öffne sie erneut, um die neue Sprache zu sehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Από προεπιλογή χρησιμοποιεί τη γλώσσα του τηλεφώνου σας. Η αλλαγή κλείνει την εφαρμογή — ανοίξτε την ξανά για να δείτε τη νέα γλώσσα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por defecto usa el idioma de tu teléfono. Al cambiarlo, la app se cierra — vuelve a abrirla para ver el nuevo idioma."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käyttää oletuksena puhelimesi kieltä. Tämä muutos sulkee sovelluksen — avaa se uudelleen nähdäksesi uuden kielen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise par défaut la langue de votre téléphone. Ce changement ferme l'app — rouvrez-la pour voir la nouvelle langue."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כברירת מחדל משתמש בשפת הטלפון שלך. שינוי זה סוגר את האפליקציה — פתח אותה מחדש כדי לראות את השפה החדשה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिफ़ॉल्ट रूप से आपके फ़ोन की भाषा उपयोग होती है। यह बदलाव ऐप बंद कर देता है — नई भाषा देखने के लिए इसे फिर से खोलें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Alapértelmezés szerint a telefon nyelvét használja. A módosítás bezárja az appot — nyisd meg újra az új nyelv megtekintéséhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Secara default menggunakan bahasa ponsel Anda. Perubahan ini menutup aplikasi — buka kembali untuk melihat bahasa baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per impostazione predefinita usa la lingua del telefono. Questa modifica chiude l'app — riaprila per vedere la nuova lingua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトはiPhoneの言語です。変更するとアプリが閉じます — 開き直すと新しい言語が反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값은 휴대폰 언어입니다. 변경하면 앱이 닫힙니다 — 다시 열면 새 언어가 적용됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruker som standard telefonens språk. Denne endringen lukker appen — åpne den på nytt for å se det nye språket."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Standaard de taal van je telefoon. Deze wijziging sluit de app — open hem opnieuw om de nieuwe taal te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Domyślnie język telefonu. Zmiana zamyka appkę — otwórz ją ponownie, żeby zobaczyć nowy język."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por padrão, usa o idioma do seu telefone. Essa alteração fecha o app — reabra-o para ver o novo idioma."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Por predefinição, usa o idioma do telemóvel. Esta alteração fecha a aplicação — reabra-a para ver o novo idioma."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește implicit limba telefonului. Această modificare închide aplicația — redeschide-o pentru a vedea noua limbă."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använder som standard telefonens språk. Ändringen stänger appen — öppna den igen för att se det nya språket."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ภาษาของโทรศัพท์เป็นค่าเริ่มต้น การเปลี่ยนแปลงนี้จะปิดแอป — เปิดแอปอีกครั้งเพื่อดูภาษาใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan olarak telefonunuzun dilini kullanır. Bu değişiklik uygulamayı kapatır — yeni dili görmek için tekrar açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За замовчуванням використовує мову телефону. Ця зміна закриває застосунок — відкрийте його знову, щоб побачити нову мову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mặc định dùng ngôn ngữ của điện thoại. Thay đổi này sẽ đóng ứng dụng — hãy mở lại để xem ngôn ngữ mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认使用手机的语言。更改会关闭应用——重新打开即可看到新语言。"
          }
        }
      }
    },
    "Defaults to your phone's language. Changing this takes effect after you reopen the app.": {
