    "Splits this time evenly across all photos/clips that don't have a manually set duration.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوزّع هذا الوقت بالتساوي على جميع الصور/المقاطع التي لم تُحدَّد مدتها يدويًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozdělí tento čas rovnoměrně mezi všechny fotky/klipy bez ručně nastavené délky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fordeler denne tid jævnt over alle billeder/klip uden manuelt indstillet varighed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verteilt diese Zeit gleichmäßig auf alle Fotos/Clips ohne manuell festgelegte Dauer."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κατανέμει αυτόν τον χρόνο ομοιόμορφα σε όλες τις φωτογραφίες/κλιπ που δεν έχουν χειροκίνητα ορισμένη διάρκεια."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reparte este tiempo de forma equitativa entre todas las fotos/clips sin duración fijada manualmente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jakaa tämän ajan tasaisesti kaikille kuville/klipeille, joilla ei ole manuaalisesti asetettua kestoa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répartit ce temps équitablement entre toutes les photos/clips sans durée définie manuellement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחלק את הזמן הזה באופן שווה בין כל התמונות/הקליפים שאין להם משך שהוגדר ידנית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह समय उन सभी फ़ोटो/क्लिप्स में समान रूप से बांटता है जिनकी अवधि मैन्युअल रूप से सेट नहीं की गई है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezt az időt egyenletesen elosztja az összes olyan fotó/klip között, amelynek nincs kézzel beállított hossza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membagi waktu ini secara merata ke semua foto/klip yang tidak memiliki durasi yang diatur secara manual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Distribuisce questo tempo in modo uniforme tra tutte le foto/clip senza una durata impostata manualmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手動で長さを設定していないすべての写真・クリップに、この時間を均等に振り分けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수동으로 길이를 설정하지 않은 모든 사진/클립에 이 시간을 균등하게 나눕니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fordeler denne tiden jevnt over alle bilder/klipp uten manuelt angitt varighet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdeelt deze tijd gelijkmatig over alle foto's/clips zonder handmatig ingestelde duur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozłoży ten czas równo na wszystkie zdjęcia/klipy, które nie mają ręcznie ustawionej długości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Distribui esse tempo igualmente entre todas as fotos/clipes sem duração definida manualmente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Distribui este tempo de forma uniforme por todas as fotos/clipes sem duração definida manualmente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Împarte acest timp egal între toate fotografiile/clipurile care nu au o durată setată manual."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fördelar den här tiden jämnt över alla foton/klipp utan manuellt inställd längd."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แบ่งเวลานี้อย่างเท่าเทียมกันในรูปภาพ/คลิปทั้งหมดที่ไม่ได้ตั้งค่าระยะเวลาด้วยตนเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu süreyi, manuel olarak süre ayarlanmamış tüm fotoğraf/kliplere eşit şekilde dağıtır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розподіляє цей час рівномірно між усіма фото/кліпами без вручну заданої тривалості."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chia đều thời gian này cho tất cả ảnh/clip chưa được đặt thời lượng thủ công."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将这段时间平均分配给所有未手动设置时长的照片/片段。"
          }
        }
      }
    },
