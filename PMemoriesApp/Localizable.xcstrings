        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετατρέψτε τις φωτογραφίες και τα βίντεό σας σε μια ταινία με μουσική με λίγα πατήματα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
