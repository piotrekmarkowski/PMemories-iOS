    "Enter cities in the order you visited them (airports work too). For each next stop, choose how you got there. Press and drag to reorder.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل المدن بالترتيب الذي زرتها فيه (المطارات تعمل أيضًا). لكل محطة تالية، اختر كيف وصلت إليها. اضغط مطولًا واسحب لإعادة الترتيب."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte města v pořadí, v jakém jste je navštívili (fungují i letiště). U každé další zastávky vyberte, jak jste se tam dostali. Přidržte a přetáhněte pro změnu pořadí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast byerne i den rækkefølge, du besøgte dem (lufthavne fungerer også). Vælg for hvert næste stop, hvordan du kom dertil. Hold nede og træk for at omarrangere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib die Städte in der Reihenfolge deines Besuchs ein (Flughäfen funktionieren auch). Wähle für jeden nächsten Stopp, wie du dorthin gekommen bist. Zum Umordnen gedrückt halten und ziehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εισαγάγετε τις πόλεις με τη σειρά που τις επισκεφθήκατε (λειτουργούν και τα αεροδρόμια). Για κάθε επόμενη στάση, επιλέξτε πώς φτάσατε εκεί. Πατήστε παρατεταμένα και σύρετε για αναδιάταξη."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce las ciudades en el orden en que las visitaste (los aeropuertos también funcionan). Para cada siguiente parada, elige cómo llegaste. Mantén pulsado y arrastra para reordenar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Syötä kaupungit siinä järjestyksessä kuin vierailit niissä (lentokentätkin käyvät). Valitse jokaiselle seuraavalle pysähdykselle, miten pääsit sinne. Paina pitkään ja vedä järjestääksesi uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez les villes dans l'ordre où vous les avez visitées (les aéroports fonctionnent aussi). Pour chaque étape suivante, choisissez comment vous y êtes arrivé. Maintenez et faites glisser pour réorganiser."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזן את הערים לפי הסדר שבו ביקרת בהן (גם שדות תעופה עובדים). לכל תחנה הבאה, בחר כיצד הגעת אליה. לחץ והחזק וגרור כדי לשנות סדר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शहरों को उसी क्रम में दर्ज करें जिसमें आपने उन्हें देखा (हवाई अड्डे भी काम करते हैं)। हर अगले पड़ाव के लिए चुनें कि आप वहां कैसे पहुंचे। क्रम बदलने के लिए दबाकर खींचें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Add meg a városokat a látogatás sorrendjében (repülőterek is működnek). Minden következő megállónál válaszd ki, hogyan jutottál oda. Nyomva tartással és húzással változtathatod a sorrendet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan kota sesuai urutan kunjungan Anda (bandara juga bisa). Untuk setiap perhentian berikutnya, pilih cara Anda tiba di sana. Tekan dan seret untuk mengubah urutan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci le città nell'ordine in cui le hai visitate (funzionano anche gli aeroporti). Per ogni tappa successiva, scegli come ci sei arrivato. Tieni premuto e trascina per riordinare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "訪れた順に都市を入力してください（空港名でもOK）。次の立ち寄り地ごとに、どうやって着いたかを選んでください。長押しでドラッグして並べ替えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방문한 순서대로 도시를 입력하세요 (공항 이름도 가능). 다음 경유지마다 어떻게 도착했는지 선택하세요. 길게 눌러서 드래그하면 순서를 바꿀 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn byene i den rekkefølgen du besøkte dem (flyplasser fungerer også). Velg for hvert neste stopp hvordan du kom dit. Trykk og dra for å endre rekkefølge."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer de steden in de volgorde van je bezoek in (luchthavens werken ook). Kies voor elke volgende stop hoe je er kwam. Houd ingedrukt en sleep om de volgorde te wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz miasta w kolejności podróży (podpowiada też lotniska). Dla każdego kolejnego przystanku wybierz, jak tam dotarłeś. Przytrzymaj i przeciągnij, żeby zmienić kolejność."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite as cidades na ordem em que você as visitou (aeroportos também funcionam). Para cada próxima parada, escolha como você chegou lá. Pressione e arraste para reordenar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduza as cidades pela ordem em que as visitou (aeroportos também funcionam). Para cada paragem seguinte, escolha como lá chegou. Mantenha premido e arraste para reordenar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdu orașele în ordinea în care le-ai vizitat (merg și aeroporturile). Pentru fiecare oprire următoare, alege cum ai ajuns acolo. Apasă și trage pentru a reordona."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange städerna i den ordning du besökte dem (flygplatser fungerar också). Välj för varje nästa stopp hur du tog dig dit. Håll ner och dra för att ändra ordning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ป้อนเมืองตามลำดับที่คุณไปเยือน (สนามบินก็ใช้ได้) สำหรับแต่ละจุดแวะถัดไป เลือกว่าคุณเดินทางไปถึงอย่างไร กดค้างแล้วลากเพื่อจัดลำดับใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şehirleri ziyaret ettiğiniz sırayla girin (havalimanları da olur). Her sonraki durak için oraya nasıl gittiğinizi seçin. Sırayı değiştirmek için basılı tutup sürükleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть міста в порядку відвідування (аеропорти теж підходять). Для кожної наступної зупинки виберіть, як ви туди дісталися. Натисніть і перетягніть, щоб змінити порядок."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập các thành phố theo thứ tự bạn đã ghé thăm (sân bay cũng được). Với mỗi điểm dừng tiếp theo, chọn cách bạn đến đó. Nhấn giữ và kéo để sắp xếp lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按你到访的顺序输入城市（机场名称也可以）。每个下一站都要选择你的到达方式。按住并拖动即可重新排序。"
          }
        }
      }
    },
