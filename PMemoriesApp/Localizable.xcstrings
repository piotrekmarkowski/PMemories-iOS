          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập bằng Apple để PMemories có thể chào bạn bằng tên và cho phép bạn tham gia Bảng xếp hạng người thử nghiệm. Hoàn toàn tùy chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Apple 登录，PMemories 就能亲切地称呼你的名字，并让你加入测试者排行榜。完全可选。"
          }
        }
      }
    },
