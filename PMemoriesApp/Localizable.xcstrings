    "No saved projects in Studio/Library — create a movie first with \\\"Create Memory\\\".": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد مشاريع محفوظة في الاستوديو/المكتبة — أنشئ فيديو أولًا باستخدام \"إنشاء ذكرى\"."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V Studiu/Knihovně nejsou žádné uložené projekty — nejprve vytvořte video pomocí \"Vytvořit vzpomínku\"."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen gemte projekter i Studio/Bibliotek — opret først en video med \"Opret minde\"."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine gespeicherten Projekte in Studio/Mediathek — erstelle zuerst ein Video mit „Erinnerung erstellen\"."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχουν αποθηκευμένα έργα στο Studio/Βιβλιοθήκη — δημιουργήστε πρώτα ένα βίντεο με «Δημιουργία Ανάμνησης»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay proyectos guardados en Studio/Biblioteca — crea primero una película con \"Crear recuerdo\"."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei tallennettuja projekteja Studiossa/Kirjastossa — luo ensin video kohdasta \"Luo muisto\"."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun projet enregistré dans Studio/Bibliothèque — créez d'abord un film avec « Créer un souvenir »."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין פרויקטים שמורים ב-Studio/ספרייה — צור תחילה סרטון באמצעות \"צור זיכרון\"."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio/लाइब्रेरी में कोई सहेजा गया प्रोजेक्ट नहीं है — पहले \"मेमोरी बनाएं\" से एक वीडियो बनाएं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs mentett projekt a Studióban/Könyvtárban — először hozz létre videót az \"Emlék létrehozása\" gombbal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada proyek tersimpan di Studio/Pustaka — buat video terlebih dahulu dengan \"Buat Kenangan\"."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun progetto salvato in Studio/Libreria — crea prima un video con \"Crea ricordo\"."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio・ライブラリに保存されたプロジェクトはありません — まず「思い出を作成」で動画を作成してください。"
          }
        },
        "ko": {
          "stringUnit": {
