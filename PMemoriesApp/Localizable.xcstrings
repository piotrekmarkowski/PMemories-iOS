  "strings": {
    "\"%@\" was added to Trip Planning.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت إضافة \"%@\" إلى تخطيط الرحلات."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ bylo přidáno do Plánování výletů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" blev tilføjet til Rejseplanlægning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ wurde zu Reiseplanung hinzugefügt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%@» προστέθηκε στον Σχεδιασμό ταξιδιού."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" se añadió a Planificación de viajes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" lisättiin Matkasuunnitteluun."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » a été ajouté à Planification de voyage."
