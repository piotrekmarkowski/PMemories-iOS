    "Editing this saved trip will replace the route you're currently building.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحرير هذه الرحلة المحفوظة سيستبدل المسار الذي تقوم ببنائه حاليًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Úprava tohoto uloženého výletu nahradí trasu, kterou právě vytváříte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Redigering af denne gemte rejse erstatter den rute, du er ved at oprette."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Bearbeiten dieser gespeicherten Reise ersetzt die Route, die du gerade erstellst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η επεξεργασία αυτού του αποθηκευμένου ταξιδιού θα αντικαταστήσει τη διαδρομή που δημιουργείς αυτή τη στιγμή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Editar este viaje guardado reemplazará la ruta que estás creando actualmente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän tallennetun matkan muokkaaminen korvaa reitin, jota olet parhaillaan luomassa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifier ce voyage enregistré remplacera l'itinéraire que vous êtes en train de créer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עריכת הטיול השמור הזה תחליף את המסלול שאתה בונה כרגע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस सहेजी गई यात्रा को संपादित करने से वह रूट बदल जाएगा जिसे आप अभी बना रहे हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mentett utazás szerkesztése lecseréli az éppen épülő útvonalat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengedit perjalanan tersimpan ini akan mengganti rute yang sedang Anda buat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modificare questo viaggio salvato sostituirà il percorso che stai creando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この保存済みの旅を編集すると、現在作成中のルートが置き換えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 여행을 편집하면 현재 만들고 있는 경로가 대체됩니다."
          }
        },
        "nb": {
          "stringUnit": {
