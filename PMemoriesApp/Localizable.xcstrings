            "value": "Redigering av denne lagrede turen vil erstatte ruten du holder på å lage."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bewerken van deze opgeslagen reis vervangt de route die je nu aan het maken bent."
