    "No entries yet — be the first!": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد إدخالات بعد — كن الأول!"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím žádné záznamy — buďte první!"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen poster endnu — bliv den første!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Einträge — sei der Erste!"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχουν ακόμη καταχωρίσεις — γίνετε ο πρώτος!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay entradas — ¡sé el primero!"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vielä merkintöjä — ole ensimmäinen!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune entrée pour l'instant — soyez le premier !"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין עדיין רשומות — היה הראשון!"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी तक कोई प्रविष्टि नहीं — पहले बनें!"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nincs bejegyzés — legyél te az első!"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada entri — jadilah yang pertama!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuna voce — sii il primo!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだエントリーがありません — 最初の一人になろう！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 항목이 없습니다 — 첫 번째가 되어보세요!"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen oppføringer ennå — bli den første!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen items — wees de eerste!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak wpisów — bądź pierwszy!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há entradas — seja o primeiro!"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há entradas — sê o primeiro!"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicio înregistrare încă — fii primul!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga poster än — bli den första!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีรายการ — เป็นคนแรกเลย!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz kayıt yok — ilk sen ol!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки немає записів — станьте першим!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có mục nào — hãy là người đầu tiên!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无记录 — 快来抢占第一！"
          }
