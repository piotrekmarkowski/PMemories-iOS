    "The app detects places and order from your photos' location and date — review and adjust the result before saving.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يكتشف التطبيق الأماكن والترتيب من موقع صورك وتاريخها — راجع النتيجة واضبطها قبل الحفظ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace rozpoznává místa a pořadí podle polohy a data vašich fotek — před uložením výsledek zkontrolujte a upravte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen registrerer steder og rækkefølge ud fra dine billeders placering og dato — gennemgå og justér resultatet, før du gemmer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App erkennt Orte und Reihenfolge anhand von Standort und Datum deiner Fotos — überprüfe und passe das Ergebnis vor dem Speichern an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εφαρμογή εντοπίζει μέρη και σειρά από την τοποθεσία και ημερομηνία των φωτογραφιών σας — ελέγξτε και προσαρμόστε το αποτέλεσμα πριν την αποθήκευση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app detecta los lugares y el orden a partir de la ubicación y fecha de tus fotos — revisa y ajusta el resultado antes de guardar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovellus tunnistaa paikat ja järjestyksen kuviesi sijainnin ja päivämäärän perusteella — tarkista ja säädä tulosta ennen tallennusta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app détecte les lieux et l'ordre à partir de la localisation et de la date de vos photos — vérifiez et ajustez le résultat avant d'enregistrer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האפליקציה מזהה מקומות וסדר על פי המיקום והתאריך של התמונות שלך — סקור והתאם את התוצאה לפני השמירה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप आपकी फ़ोटो के स्थान और तारीख़ से जगहें और क्रम पहचानता है — सहेजने से पहले परिणाम की समीक्षा करें और समायोजित करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az app a fotóid helye és dátuma alapján ismeri fel a helyeket és a sorrendet — mentés előtt tekintsd át és igazítsd az eredményt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi mendeteksi tempat dan urutan dari lokasi dan tanggal foto Anda — tinjau dan sesuaikan hasilnya sebelum menyimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app rileva i luoghi e l'ordine dalla posizione e dalla data delle tue foto — controlla e correggi il risultato prima di salvare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリは写真の位置情報と日付から場所と順序を検出します — 保存する前に結果を確認・調整してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 사진의 위치와 날짜를 바탕으로 장소와 순서를 감지합니다 — 저장하기 전에 결과를 검토하고 조정하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen oppdager steder og rekkefølge fra bildenes posisjon og dato — se gjennom og juster resultatet før du lagrer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app herkent plaatsen en volgorde aan de hand van de locatie en datum van je foto's — controleer en pas het resultaat aan voordat je opslaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Appka rozpozna miejsca i kolejność na podstawie lokalizacji i daty zdjęć — sprawdź i popraw wynik przed zapisaniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app detecta lugares e a ordem a partir da localização e data das suas fotos — revise e ajuste o resultado antes de salvar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A aplicação deteta locais e a ordem a partir da localização e data das suas fotos — reveja e ajuste o resultado antes de guardar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicația detectează locurile și ordinea din locația și data fotografiilor tale — verifică și ajustează rezultatul înainte de a salva."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen identifierar platser och ordning utifrån dina fotons plats och datum — granska och justera resultatet innan du sparar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปตรวจจับสถานที่และลำดับจากตำแหน่งและวันที่ของรูปภาพคุณ — ตรวจสอบและปรับผลลัพธ์ก่อนบันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama, fotoğraflarınızın konumu ve tarihinden yerleri ve sırayı tespit eder — kaydetmeden önce sonucu gözden geçirin ve ayarlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосунок визначає місця та порядок за розташуванням і датою ваших фото — перегляньте та скоригуйте результат перед збереженням."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng phát hiện địa điểm và thứ tự từ vị trí và ngày của ảnh — hãy xem lại và điều chỉnh kết quả trước khi lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用会根据照片的位置和日期检测地点和顺序——保存前请检查并调整结果。"
          }
        }
      }
    },
    "The detected route will replace the current stops in the list.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيحل المسار المكتشف محل المحطات الحالية في القائمة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoznaná trasa nahradí stávající zastávky v seznamu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den registrerede rute erstatter de nuværende stop på listen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die erkannte Route ersetzt die aktuellen Stopps in der Liste."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εντοπισμένη διαδρομή θα αντικαταστήσει τις τρέχουσες στάσεις στη λίστα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ruta detectada reemplazará las paradas actuales de la lista."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunnistettu reitti korvaa nykyiset pysähdykset listalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'itinéraire détecté remplacera les étapes actuelles de la liste."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המסלול שזוהה יחליף את התחנות הנוכחיות ברשימה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पता लगाया गया रूट सूची में मौजूदा पड़ावों की जगह लेगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A felismert útvonal lecseréli a lista jelenlegi megállóit."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rute yang terdeteksi akan menggantikan perhentian saat ini dalam daftar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il percorso rilevato sostituirà le tappe attuali nell'elenco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検出されたルートは、リスト内の現在の立ち寄り地を置き換えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "감지된 경로가 목록의 현재 경유지를 대체합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den oppdagede ruten erstatter de nåværende stoppene i listen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De herkende route vervangt de huidige stops in de lijst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykryta trasa zastąpi obecne przystanki na liście."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A rota detectada substituirá as paradas atuais na lista."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A rota detetada substituirá as paragens atuais na lista."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruta detectată va înlocui opririle actuale din listă."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den identifierade rutten ersätter de nuvarande stoppen i listan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เส้นทางที่ตรวจพบจะแทนที่จุดแวะปัจจุบันในรายการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tespit edilen rota, listedeki mevcut durakların yerini alacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Визначений маршрут замінить поточні зупинки у списку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lộ trình được phát hiện sẽ thay thế các điểm dừng hiện tại trong danh sách."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测到的路线将替换列表中当前的途经点。"
          }
        }
      }
    },
    "This place isn't linked to a video yet — link it in Travel Map (the 🎞️ button next to the stop).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم ربط هذا المكان بفيديو بعد — اربطه في خريطة السفر (زر 🎞️ بجانب المحطة)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto místo ještě není propojeno s videem — propojte ho v Mapě cest (tlačítko 🎞️ vedle zastávky)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette sted er endnu ikke knyttet til en video — knyt det i Rejsekort (🎞️-knappen ved siden af stoppet)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Ort ist noch mit keinem Video verknüpft — verknüpfe ihn in der Reisekarte (die 🎞️-Schaltfläche neben dem Stopp)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το μέρος δεν έχει συνδεθεί ακόμα με βίντεο — συνδέστε το στον Χάρτη Ταξιδιού (το κουμπί 🎞️ δίπλα στη στάση)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este lugar aún no está vinculado a un vídeo — vincúlalo en Mapa de Viajes (el botón 🎞️ junto a la parada)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä paikkaa ei ole vielä linkitetty videoon — linkitä se Matkakartassa (🎞️-painike pysähdyksen vieressä)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce lieu n'est pas encore associé à une vidéo — associez-le dans Carte de Voyage (le bouton 🎞️ à côté de l'étape)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המקום הזה עדיין לא מקושר לסרטון — קשר אותו במפת הטיולים (כפתור 🎞️ ליד התחנה)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह स्थान अभी किसी वीडियो से लिंक नहीं है — इसे ट्रैवल मैप में लिंक करें (पड़ाव के बगल में 🎞️ बटन)।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a hely még nincs videóhoz kapcsolva — kapcsold össze az Útitérképen (a megálló melletti 🎞️ gomb)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempat ini belum ditautkan ke video — tautkan di Peta Perjalanan (tombol 🎞️ di sebelah perhentian)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo luogo non è ancora collegato a un video — collegalo in Mappa dei Viaggi (il pulsante 🎞️ accanto alla tappa)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この場所はまだ動画にリンクされていません — 旅行マップでリンクしてください（立ち寄り地の横にある🎞️ボタン）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 장소는 아직 동영상에 연결되어 있지 않습니다 — 여행 지도에서 연결하세요 (경유지 옆의 🎞️ 버튼)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette stedet er ikke koblet til en video ennå — koble det i Reisekart (🎞️-knappen ved siden av stoppet)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze plek is nog niet gekoppeld aan een video — koppel deze in Reiskaart (de 🎞️-knop naast de stop)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To miejsce nie jest jeszcze połączone z żadnym filmem — połącz je w Travel Map (przycisk 🎞️ przy przystanku)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este lugar ainda não está vinculado a um vídeo — vincule-o no Mapa de Viagens (o botão 🎞️ ao lado da parada)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este local ainda não está associado a um vídeo — associe-o no Mapa de Viagens (o botão 🎞️ junto à paragem)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest loc nu este încă legat de un videoclip — leagă-l în Harta Călătoriilor (butonul 🎞️ de lângă oprire)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här platsen är inte länkad till en video ännu — länka den i Reskarta (🎞️-knappen bredvid stoppet)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สถานที่นี้ยังไม่ได้เชื่อมโยงกับวิดีโอ — เชื่อมโยงในแผนที่การเดินทาง (ปุ่ม 🎞️ ข้างจุดแวะ)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yer henüz bir videoya bağlanmadı — Seyahat Haritası'nda bağlayın (durağın yanındaki 🎞️ düğmesi)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це місце ще не пов'язане з відео — прив'яжіть його в Мапі подорожей (кнопка 🎞️ поруч із зупинкою)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Địa điểm này chưa được liên kết với video — hãy liên kết trong Bản đồ du lịch (nút 🎞️ cạnh điểm dừng)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个地点还没有关联视频——请在旅行地图中关联（途经点旁边的 🎞️ 按钮）。"
          }
        }
      }
    },
    "This sends your planned stops to Travel Map and removes them from Trip Planning.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى إرسال المحطات المخطط لها إلى خريطة السفر وإزالتها من Trip Planning."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tímto se vaše plánované zastávky odešlou do Mapy cest a odstraní se z Trip Planning."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette sender dine planlagte stop til Rejsekortet og fjerner dem fra Trip Planning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden deine geplanten Stopps an die Reisekarte gesendet und aus Trip Planning entfernt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό θα στείλει τις προγραμματισμένες στάσεις σας στον Χάρτη Ταξιδιού και θα τις αφαιρέσει από το Trip Planning."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto enviará tus paradas planificadas al Mapa de Viajes y las eliminará de Trip Planning."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä lähettää suunnitellut pysähdyksesi Matkakartalle ja poistaa ne Trip Planningista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela enverra vos étapes prévues à la carte de voyage et les supprimera de Trip Planning."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו תשלח את העצירות המתוכננות שלך למפת הטיולים ותסיר אותן מ-Trip Planning."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे आपके नियोजित पड़ाव Travel Map पर भेज दिए जाएंगे और Trip Planning से हटा दिए जाएंगे।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez elküldi a tervezett megállóidat az Utazási térképre, és eltávolítja őket a Trip Planningből."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan mengirim perhentian yang direncanakan ke Peta Perjalanan dan menghapusnya dari Trip Planning."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo invierà le tue tappe pianificate alla Mappa di Viaggio e le rimuoverà da Trip Planning."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、計画した立ち寄り先がTravel Mapに送信され、Trip Planningから削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이렇게 하면 계획한 정류지가 Travel Map으로 전송되고 Trip Planning에서 삭제됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette sender de planlagte stoppene dine til Reisekartet og fjerner dem fra Trip Planning."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit stuurt je geplande stops naar Travel Map en verwijdert ze uit Trip Planning."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To wyśle Twoje zaplanowane przystanki do Mapy Podróży i usunie je z Trip Planning."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso enviará suas paradas planejadas para o Mapa de Viagens e as removerá do Trip Planning."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto envia as tuas paragens planeadas para o Mapa de Viagens e remove-as do Trip Planning."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta va trimite opririle planificate către Harta călătoriilor și le va elimina din Trip Planning."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta skickar dina planerade stopp till Reskartan och tar bort dem från Trip Planning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะส่งจุดแวะที่วางแผนไว้ไปยัง Travel Map และลบออกจาก Trip Planning"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, planladığın durakları Seyahat Haritası'na gönderir ve Trip Planning'den kaldırır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це надішле ваші заплановані зупинки на Карту подорожей і видалить їх із Trip Planning."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này sẽ gửi các điểm dừng đã lên kế hoạch đến Travel Map và xóa chúng khỏi Trip Planning."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会将你计划的站点发送到旅行地图，并将其从行程规划中移除。"
          }
        }
      }
    },
    "This trip needs at least two stops with a location set.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الرحلة تحتاج إلى موقعين على الأقل بإحداثيات محددة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento výlet potřebuje alespoň dvě zastávky s nastavenou polohou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne rejse kræver mindst to stop med en placering angivet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Reise braucht mindestens zwei Stopps mit festgelegtem Standort."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το ταξίδι χρειάζεται τουλάχιστον δύο στάσεις με ορισμένη τοποθεσία."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este viaje necesita al menos dos paradas con una ubicación definida."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä matka tarvitsee vähintään kaksi pysähdystä, joilla on sijainti asetettuna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce voyage a besoin d'au moins deux étapes avec un emplacement défini."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הטיול הזה זקוק לפחות לשתי תחנות עם מיקום מוגדר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस यात्रा के लिए स्थान सेट किए हुए कम से कम दो पड़ाव चाहिए।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ehhez az utazáshoz legalább két, helyadatokkal rendelkező megálló szükséges."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perjalanan ini membutuhkan setidaknya dua pemberhentian dengan lokasi yang ditetapkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo viaggio richiede almeno due tappe con una posizione impostata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この旅には位置情報が設定された立ち寄り先が少なくとも2つ必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 여행에는 위치가 설정된 정류장이 최소 두 곳 필요합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne reisen trenger minst to stopp med en plassering angitt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze reis heeft minstens twee stops met een ingestelde locatie nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta podróż wymaga co najmniej dwóch przystanków z ustawioną lokalizacją."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta viagem precisa de pelo menos duas paradas com localização definida."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta viagem precisa de pelo menos duas paragens com localização definida."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această călătorie are nevoie de cel puțin două opriri cu o locație setată."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här resan behöver minst två stopp med en angiven plats."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทริปนี้ต้องมีจุดแวะพักอย่างน้อยสองจุดที่ตั้งค่าตำแหน่งไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gezi için konumu ayarlanmış en az iki durak gerekiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для цієї подорожі потрібно щонайменше дві зупинки з визначеним місцем."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyến đi này cần ít nhất hai điểm dừng có vị trí được thiết lập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此行程至少需要两个已设置位置的停靠点。"
          }
        }
      }
    },
