    "Add translations of your captions — shown together with the original, right in the exported video.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف ترجمات لتعليقاتك — تظهر مع النص الأصلي مباشرة في الفيديو المصدَّر."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte překlady svých titulků — zobrazí se spolu s originálem přímo ve vyexportovaném videu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj oversættelser af dine billedtekster — vises sammen med originalen direkte i den eksporterede video."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Übersetzungen deiner Untertitel hinzu — sie erscheinen zusammen mit dem Original direkt im exportierten Video."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε μεταφράσεις των λεζάντων σας — εμφανίζονται μαζί με το πρωτότυπο απευθείας στο εξαγόμενο βίντεο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade traducciones de tus subtítulos: aparecen junto con el original directamente en el vídeo exportado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää käännöksiä tekstityksiisi — ne näkyvät alkuperäisen kanssa suoraan viedyssä videossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des traductions de vos sous-titres — elles apparaissent avec l'original directement dans la vidéo exportée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסיפו תרגומים לכתוביות שלכם — יופיעו יחד עם המקור ישירות בסרטון המיוצא."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने कैप्शन के अनुवाद जोड़ें — निर्यात की गई वीडियो में मूल के साथ ही दिखाई देंगे।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj hozzá fordításokat a feliratokhoz — az eredetivel együtt jelennek meg az exportált videóban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan terjemahan teksmu — muncul bersama teks asli langsung di video hasil ekspor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi traduzioni delle didascalie: appaiono insieme all'originale direttamente nel video esportato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャプションの翻訳を追加すると、書き出した動画内で原文と一緒に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자막 번역을 추가하면 내보낸 영상에서 원문과 함께 바로 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til oversettelser av tekstene dine — vises sammen med originalen rett i den eksporterte videoen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg vertalingen van je bijschriften toe — ze verschijnen samen met het origineel in de geëxporteerde video."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj tłumaczenia napisów — pojawią się razem z oryginałem prosto w wyeksportowanym filmie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione traduções das suas legendas — aparecem junto com o original diretamente no vídeo exportado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione traduções das suas legendas — aparecem junto com o original diretamente no vídeo exportado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă traduceri ale subtitrărilor tale — apar împreună cu originalul direct în videoclipul exportat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till översättningar av dina texter — visas tillsammans med originalet direkt i den exporterade videon."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มคำแปลของคำบรรยายของคุณ — จะแสดงพร้อมกับต้นฉบับโดยตรงในวิดีโอที่ส่งออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Altyazılarının çevirilerini ekle — dışa aktarılan videoda orijinaliyle birlikte gösterilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте переклади своїх субтитрів — з'являться разом з оригіналом прямо в експортованому відео."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm bản dịch cho chú thích của bạn — sẽ hiển thị cùng bản gốc ngay trong video xuất ra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为字幕添加翻译——会与原文一起直接显示在导出的视频中。"
          }
        }
      }
    },
