    "Applies a color look to the whole movie. Adds a bit of extra export time.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطبّق مظهرًا لونيًا على الفيلم بأكمله. يضيف بعض وقت التصدير الإضافي."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použije barevný vzhled na celý film. Přidá trochu času navíc k exportu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføjer et farvelook til hele filmen. Giver lidt ekstra eksporttid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wendet einen Farblook auf den gesamten Film an. Verlängert die Exportzeit etwas."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εφαρμόζει μια χρωματική εμφάνιση σε ολόκληρη την ταινία. Προσθέτει λίγο επιπλέον χρόνο εξαγωγής."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica un estilo de color a toda la película. Añade algo más de tiempo de exportación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää värisävyn koko elokuvaan. Pidentää hieman vientiaikaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Applique un rendu colorimétrique à tout le film. Ajoute un peu de temps d'exportation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחיל מראה צבע על כל הסרט. מוסיף מעט זמן ייצוא נוסף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरी मूवी पर एक कलर लुक लागू करता है। इससे एक्सपोर्ट में थोड़ा अतिरिक्त समय लगता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Színes megjelenést ad az egész filmnek. Kicsit tovább tart az exportálás."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menerapkan tampilan warna ke seluruh film. Menambah sedikit waktu ekspor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Applica un look colore a tutto il filmato. Aggiunge un po' di tempo all'esportazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画全体にカラールックを適用します。書き出し時間が少し長くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 영상에 색감을 적용합니다. 내보내기 시간이 조금 더 걸립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gir hele filmen et fargeuttrykk. Legger til litt ekstra eksporttid."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Past een kleurlook toe op de hele film. Zorgt voor iets meer exporttijd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakłada wygląd kolorystyczny na cały film. Wydłuża trochę czas eksportu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica um visual de cor a todo o filme. Adiciona um pouco mais de tempo de exportação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica um visual de cor a todo o filme. Acrescenta algum tempo extra à exportação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplică un aspect de culoare pe tot filmul. Adaugă puțin timp suplimentar la export."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ger hela filmen ett färgutseende. Ger lite extra exporttid."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้โทนสีกับวิดีโอทั้งเรื่อง เพิ่มเวลาส่งออกเล็กน้อย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm filme bir renk görünümü uygular. Biraz ekstra dışa aktarma süresi ekler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосовує колірний стиль до всього фільму. Додає трохи часу до експорту."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Áp dụng tông màu cho toàn bộ phim. Tăng thêm một chút thời gian xuất video."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为整部影片应用色彩风格。会略微增加导出时间。"
          }
        }
      }
    },
