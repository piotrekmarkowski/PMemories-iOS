    "No trips saved yet — build a route on the Travel Map to see it here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد رحلات محفوظة بعد — أنشئ مسارًا في خريطة السفر لتراه هنا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím žádné uložené výlety — vytvořte trasu na Mapě cest, aby se zde zobrazila."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen gemte rejser endnu — opret en rute på Rejsekortet for at se den her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine gespeicherten Reisen — erstelle eine Route auf der Reisekarte, um sie hier zu sehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχουν αποθηκευμένα ταξίδια ακόμα — δημιούργησε μια διαδρομή στον Χάρτη Ταξιδιών για να τη δεις εδώ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay viajes guardados — crea una ruta en el Mapa de Viajes para verla aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vielä tallennettuja matkoja — luo reitti Matkakartalla nähdäksesi sen täällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun voyage enregistré pour le moment — créez un itinéraire sur la Carte de Voyage pour le voir ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין אין טיולים שמורים — צור מסלול במפת הטיולים כדי לראות אותו כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी तक कोई यात्रा सहेजी नहीं गई — इसे यहां देखने के लिए ट्रैवल मैप पर एक रूट बनाएं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nincs mentett utazás — hozz létre egy útvonalat az Utazási térképen, hogy itt lásd."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada perjalanan tersimpan — buat rute di Peta Perjalanan untuk melihatnya di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun viaggio salvato — crea un percorso sulla Mappa di Viaggio per vederlo qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存された旅はまだありません — トラベルマップでルートを作成するとここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 여행이 아직 없습니다 — 트래블 맵에서 경로를 만들면 여기에 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen lagrede turer ennå — lag en rute på Reisekartet for å se den her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen opgeslagen reizen — maak een route op de Reiskaart om deze hier te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak zapisanych podróży — zbuduj trasę na Travel Map, żeby zobaczyć ją tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há viagens salvas — crie uma rota no Mapa de Viagem para vê-la aqui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não existem viagens guardadas — cria um percurso no Mapa de Viagem para o veres aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu există încă excursii salvate — creează o rută pe Harta de Călătorie pentru a o vedea aici."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga sparade resor än — skapa en rutt på Reskartan för att se den här."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีทริปที่บันทึกไว้ — สร้างเส้นทางบนแผนที่การเดินทางเพื่อดูที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz kaydedilmiş bir gezi yok — burada görmek için Seyahat Haritası'nda bir rota oluştur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки що немає збережених подорожей — створіть маршрут на Карті подорожей, щоб побачити його тут."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có chuyến đi nào được lưu — tạo một tuyến đường trên Bản đồ Du lịch để xem tại đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有保存的旅程 — 在旅行地图上创建路线即可在此查看。"
          }
        }
      }
    },
