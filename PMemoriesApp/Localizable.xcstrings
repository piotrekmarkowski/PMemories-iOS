    "Turn your photos and videos into a movie, set to music, in a few taps.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حوّل صورك ومقاطع الفيديو إلى فيلم مصحوب بموسيقى بضع نقرات فقط."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Proměňte své fotky a videa v film s hudbou během pár klepnutí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gør dine billeder og videoer til en film med musik på få tryk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwandle deine Fotos und Videos mit wenigen Tipps in einen Film mit Musik."
