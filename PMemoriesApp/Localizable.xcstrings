            "value": "Export může chvíli trvat (odhad ~%@) — pracujeme na tom, aby byl rychlejší 🙂"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksport kan tage et stykke tid (ca. ~%@) — vi arbejder på at gøre det hurtigere 🙂"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Export kann eine Weile dauern (ca. ~%@) — wir arbeiten daran, ihn schneller zu machen 🙂"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εξαγωγή μπορεί να διαρκέσει λίγο (εκτ. ~%@) — δουλεύουμε για να γίνει πιο γρήγορη 🙂"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La exportación puede tardar un rato (aprox. ~%@) — estamos trabajando para hacerla más rápida 🙂"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vienti voi kestää hetken (arvio ~%@) — teemme töitä nopeuttaaksemme sitä 🙂"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'export peut prendre du temps (env. ~%@) — nous travaillons pour le rendre plus rapide 🙂"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הייצוא עשוי לקחת זמן (משוער ~%@) — אנחנו עובדים על להפוך אותו למהיר יותר 🙂"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक्सपोर्ट में कुछ समय लग सकता है (अनुमानित ~%@) — हम इसे तेज़ बनाने पर काम कर रहे हैं 🙂"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az exportálás eltarthat egy ideig (becsült ~%@) — dolgozunk azon, hogy gyorsabb legyen 🙂"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekspor bisa memakan waktu (perkiraan ~%@) — kami sedang berupaya membuatnya lebih cepat 🙂"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'esportazione potrebbe richiedere tempo (stimato ~%@) — stiamo lavorando per renderla più veloce 🙂"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出しには時間がかかる場合があります（目安 ~%@）— より高速化するよう取り組んでいます 🙂"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내보내기에 시간이 걸릴 수 있습니다 (예상 ~%@) — 더 빠르게 만들기 위해 노력하고 있어요 🙂"
          }
        },
        "nb": {
